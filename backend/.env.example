# Copy this file to .env and fill in the real values. .env is gitignored
# (see the repo root .gitignore) — never commit real secrets.

# Airtable Personal Access Token. Create one at
# https://airtable.com/create/tokens with scopes data.records:read and
# data.records:write, and access to the base below. This is the one
# secret this whole project needs and does not currently have.
AIRTABLE_PAT=

# These two are not secret (they're just identifiers), but are kept as
# env vars so the backend isn't hardcoded to one base/table.
AIRTABLE_BASE_ID=appFUvcg5tY2Dup8U
AIRTABLE_USERS_TABLE_ID=tblOql5BcXCNhPFIS

# Optional — defaults to 3001 if unset.
PORT=3001

# Origin the frontend is served from — required for credentialed
# cross-origin requests (session cookie) to work. Defaults to
# http://localhost:3000 (the `npm run dev` static server) if unset.
FRONTEND_ORIGIN=http://localhost:3000

# Secret used to sign the session cookie. If unset, a random one is
# generated per-process (a warning is printed) — fine for local testing,
# but every restart invalidates all sessions, so set a real persistent
# value before anything beyond local testing. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
